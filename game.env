# =============================================================================
# ASA Dedicated Server — Game Settings
# These values are written into GameUserSettings.ini and Game.ini every time
# the container starts.  Edit here, then `docker compose restart` to apply.
#
# All numeric multipliers: 1.0 = vanilla.  Higher = more generous to players.
# All booleans: true / false  (case-insensitive)
# =============================================================================

# ── XP & Leveling ─────────────────────────────────────────────────────────────
XP_MULTIPLIER=1.0
KILL_XP_MULTIPLIER=1.0
HARVEST_XP_MULTIPLIER=1.0
CRAFT_XP_MULTIPLIER=1.0

# ── Gathering ─────────────────────────────────────────────────────────────────
HARVEST_AMOUNT=1.0
RESOURCE_RESPAWN_PERIOD=1.0       # Lower = faster respawn
GLOBAL_SPOILING_TIME=1.0
GLOBAL_ITEM_DECOMP=1.0
GLOBAL_CORPSE_DECOMP=1.0

# ── Taming & Breeding ────────────────────────────────────────────────────────
TAMING_SPEED=1.0
LAY_EGG_INTERVAL=1.0              # Higher = less frequent
MATING_INTERVAL=1.0               # Higher = longer wait between mates
EGG_HATCH_SPEED=1.0
BABY_MATURE_SPEED=1.0
BABY_FOOD_CONSUMPTION=1.0

# ── Player Modifiers ─────────────────────────────────────────────────────────
PLAYER_DAMAGE=1.0
PLAYER_RESISTANCE=1.0
PLAYER_HEALTH_RECOVERY=1.0
PLAYER_STAMINA_DRAIN=1.0
PLAYER_FOOD_DRAIN=1.0
PLAYER_WATER_DRAIN=1.0

# ── Dino Modifiers ───────────────────────────────────────────────────────────
DINO_DAMAGE=1.0
DINO_RESISTANCE=1.0
DINO_HEALTH_RECOVERY=1.0
DINO_STAMINA_DRAIN=1.0
DINO_FOOD_DRAIN=1.0

# ── World & Resources ─────────────────────────────────────────────────────────
CROP_GROWTH_SPEED=1.0
CROP_DECAY_SPEED=1.0
FUEL_CONSUMPTION=1.0

# ── Server Rules ─────────────────────────────────────────────────────────────
ALLOW_THIRD_PERSON=true
ALLOW_FLYER_CARRY_PVE=false
DISABLE_DINO_DECAY_PVE=false
ALLOW_CAVE_BUILDING_PVE=false
ALWAYS_ALLOW_STRUCTURE_PICKUP=true
STRUCTURE_PICKUP_HOLD_DURATION=0.5
ADMIN_LOGGING=false
SHOW_DAMAGE_TEXT=true
ALLOW_HIT_MARKERS=true
IDLE_KICK_INTERVAL=0              # Seconds before idle player is kicked; 0 = disabled
MAX_TRIBE_LOG_ENTRIES=100
MAX_PLAYERS_IN_TRIBE=0            # 0 = unlimited

# Active holiday event — leave blank for none
# Options: FearEvolved | TurkeyCarnival | WinterWonderland | LoveEvolved | Eggcellent | Birthday
ACTIVE_EVENT=

# ── Difficulty (Game.ini) ─────────────────────────────────────────────────────
# OverrideOfficialDifficulty controls max wild dino level.
#   5.0 = official (max level 150) — recommended baseline
OVERRIDE_OFFICIAL_DIFFICULTY=5.0
DIFFICULTY_OFFSET=1.0

# ── Loot Quality (Game.ini) ───────────────────────────────────────────────────
SUPPLY_LOOT_QUALITY=1.0
FISHING_LOOT_QUALITY=1.0

# ── Message of the Day ────────────────────────────────────────────────────────
MOTD_MESSAGE=Welcome to the server!
MOTD_DURATION=20
