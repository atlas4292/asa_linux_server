# ─────────────────────────────────────────────────────────────────────────────
# ARK: Survival Ascended — Dedicated Server Configuration
# Copy this file to .env and edit before running `docker compose up -d --build`
# ─────────────────────────────────────────────────────────────────────────────

# ── Build: Proton-GE version ──────────────────────────────────────────────────
# Change to a newer GE-ProtonX-Y tag if needed, then rebuild the image:
#   docker compose build --no-cache
# Releases: https://github.com/GloriousEggroll/proton-ge-custom/releases
PROTON_VERSION=GE-Proton9-20

# ── Container UID/GID (match your host user to avoid volume permission issues)
PUID=1000
PGID=1000

# ─────────────────────────────────────────────────────────────────────────────
# Server Identity
# ─────────────────────────────────────────────────────────────────────────────
SESSION_NAME=My ASA Server

# Leave blank for a public (password-free) server
SERVER_PASSWORD=

# IMPORTANT: Change this before running — grants full admin access in-game
ADMIN_PASSWORD=changeme_now

# ─────────────────────────────────────────────────────────────────────────────
# Map Selection   (must end with _WP)
# ─────────────────────────────────────────────────────────────────────────────
#   TheIsland_WP        — The Island (default, free with game)
#   ScorchedEarth_WP    — Scorched Earth (DLC)
#   Aberration_WP       — Aberration (DLC)
#   TheCenter_WP        — The Center (free DLC)
#   Extinction_WP       — Extinction (DLC)
#   Genesis_WP          — Genesis Part 1 (DLC)
#   Genesis2_WP         — Genesis Part 2 (DLC)
MAP=TheIsland_WP

# ─────────────────────────────────────────────────────────────────────────────
# Capacity
# ─────────────────────────────────────────────────────────────────────────────
MAX_PLAYERS=70

# ─────────────────────────────────────────────────────────────────────────────
# Network Ports
# ─────────────────────────────────────────────────────────────────────────────
# If running multiple server instances on the same host, increment each port
# by at least 2 per instance (e.g., second instance: 7779, 27017, 27022)
GAME_PORT=7777
QUERY_PORT=27015
RCON_PORT=27020
RCON_ENABLED=True

# ─────────────────────────────────────────────────────────────────────────────
# Anti-Cheat
# ─────────────────────────────────────────────────────────────────────────────
# BattlEye does not function under Wine/Proton — must remain true
DISABLE_BATTLEYE=true

# ─────────────────────────────────────────────────────────────────────────────
# Update Behaviour
# ─────────────────────────────────────────────────────────────────────────────
# true  — SteamCMD validates and updates the server files on every start
# false — Skip update check (faster startup after initial download)
AUTO_UPDATE=true

# ─────────────────────────────────────────────────────────────────────────────
# Extra Launch Flags  (appended verbatim to the server command line)
# ─────────────────────────────────────────────────────────────────────────────
# Examples:
#   Multi-home cluster: -ClusterDirOverride=/ark/cluster -clusterid=mycluster
#   Custom ini dir:     -ServerGameIni=/ark/server/Game.ini
#   Force PvE:          (set in GameUserSettings.ini instead)
EXTRA_FLAGS=
